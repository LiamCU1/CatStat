# Takes: a column of years (string or numeric)
# Returns: a column of decades (factors)
years_to_decades <- function(years){
decade.levels <- c("2000s", "2010s", "2020s")
d.breaks <- c(2010, 2020)
decades <- years |> as.numeric() |> cut(breaks = d.breaks, include.lowest = TRUE) |>
fct_recode( !!!decade.levels)
return(decades)
}
bf_wk |> mutate(decade = years_to_decades(year)) |> select(decade)
?cut
# Takes: a column of years (string or numeric)
# Returns: a column of decades (factors)
years_to_decades <- function(years){
decade.levels <- c("2000s", "2010s", "2020s")
d.breaks <- c(2010, 2020)
decades <- years |> as.numeric() |>
cut(breaks = d.breaks, labels = decade.levels, include.lowest = TRUE)
return(decades)
}
bf_wk |> mutate(decade = years_to_decades(year)) |> select(decade)
# Takes: a column of years (string or numeric)
# Returns: a column of decades (factors)
years_to_decades <- function(years){
