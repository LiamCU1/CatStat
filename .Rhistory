import_value_names <- function(field, filenames){
flnm <- paste0("~/CatStat/Data/", filenames[field])
flimp <- read.csv(flnm, header = TRUE)
vals.og <- flimp[["Term.Name"]]
vals.short <- flimp[["Short.Name"]]
valnames <- list(orig = vals.og, short = vals.short)
return(valnames)
}
